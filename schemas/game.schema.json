{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/agent-collab-goals/game.schema.json",
  "title": "Game",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "status",
    "supported_level_types",
    "supported_player_types",
    "action_protocol",
    "scoring",
    "fairness_rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^game-[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "archived"]
    },
    "supported_level_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["static", "agent_directed_dynamic"]
      }
    },
    "supported_player_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["human", "agent"]
      }
    },
    "action_protocol": {
      "type": "object"
    },
    "scoring": {
      "type": "object"
    },
    "fairness_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

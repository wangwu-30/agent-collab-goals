{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/agent-collab-goals/agent-context.schema.json",
  "title": "AgentContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "avatar",
    "capabilities",
    "origin_task",
    "progress",
    "dynamic_context",
    "current_context_size",
    "max_size"
  ],
  "properties": {
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "instructions"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string"
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "capability.schema.json"
      },
      "contains": {
        "type": "object",
        "required": ["name", "trigger"],
        "properties": {
          "name": {
            "const": "handoff"
          },
          "trigger": {
            "const": "near_context_limit"
          }
        }
      }
    },
    "origin_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "objective", "constraints", "success_criteria"],
      "properties": {
        "request": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completed", "current", "blockers", "next_steps"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "blocked", "done"]
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current": {
          "type": "string"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dynamic_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "content"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["observation", "thought", "action", "result", "reflection"]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "current_context_size": {
      "type": "integer",
      "minimum": 0
    },
    "max_size": {
      "type": "integer",
      "minimum": 1
    },
    "context_unit": {
      "type": "string",
      "enum": ["tokens", "bytes", "chars"]
    },
    "handoff_threshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    }
  }
}

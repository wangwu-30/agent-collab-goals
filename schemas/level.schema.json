{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/agent-collab-goals/level.schema.json",
  "title": "Level",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "game_id",
    "title",
    "level_type",
    "builder",
    "summary",
    "player_interface",
    "objective",
    "rules",
    "acceptance_criteria",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^level-[a-z0-9][a-z0-9-]*$"
    },
    "game_id": {
      "type": "string",
      "pattern": "^game-[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "level_type": {
      "type": "string",
      "enum": ["static", "agent_directed_dynamic"]
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["human_builder", "builder_agent"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "player_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_player_types", "observations", "actions"],
      "properties": {
        "supported_player_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["human", "agent"]
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "objective": {
      "type": "object"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "director": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_role",
        "permissions",
        "forbidden_actions",
        "fairness_constraints",
        "event_log"
      ],
      "properties": {
        "agent_role": {
          "type": "string",
          "minLength": 1
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fairness_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "event_log": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

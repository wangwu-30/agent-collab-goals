{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/agent-collab-goals/task.schema.json",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "goal_id",
    "title",
    "status",
    "owner",
    "scope",
    "acceptance_criteria",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^task-[a-z0-9][a-z0-9-]*$"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^goal-[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["ready", "claimed", "active", "blocked", "review", "done"]
    },
    "owner": {
      "type": ["string", "null"]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
